---
import Layout from "../layouts/Layout.astro";
import InflationChart from "../components/InflationChart";
import InflationGraph from "../components/InflationGraph";
---

<Layout
  title="Inflación"
  description="Inflación mensual de Argentina: serie histórica por década y año, evolución en el tiempo y promedios para analizar la economía argentina."
>
  <div
    class="flex flex-col md:flex-row justify-center gap-4 sm:gap-6 m-auto max-w-5xl w-full px-3 sm:px-4"
  >
    <InflationGraph client:load />
    <InflationChart client:load />
  </div>
</Layout>
