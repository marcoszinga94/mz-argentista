---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Página no encontrada"
  description="La página que buscás no existe o cambió de dirección."
>
  <section
    class="flex flex-col items-center justify-center gap-4 m-auto max-w-xl w-full text-center px-4"
  >
    <p class="text-6xl sm:text-7xl font-black text-blue-600 tracking-tight">404</p>
    <h1 class="text-2xl sm:text-3xl font-bold text-gray-800">
      No encontramos esta página
    </h1>
    <p class="text-sm sm:text-base text-gray-500">
      Puede que el enlace esté roto o que la página se haya mudado.
    </p>
    <a
      href="/"
      class="mt-2 px-5 py-2.5 rounded-xl bg-blue-600 text-white font-semibold hover:bg-blue-700 transition-colors"
    >
      Volver al inicio
    </a>
  </section>
</Layout>
