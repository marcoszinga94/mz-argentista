---
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Inicio" },
  { href: "/dolar", label: "Dólar" },
  { href: "/inflacion", label: "Inflación" },
];

const fetchDollarPrices = async () => {
  try {
    const response = await fetch("https://dolarapi.com/v1/dolares", {
      signal: AbortSignal.timeout(3000),
    });
    if (!response.ok) {
      return [];
    }
    const data = await response.json();
    return Array.isArray(data) ? data : [];
  } catch {
    return [];
  }
};

const dollarPrices = await fetchDollarPrices();
const copies = [0, 1, 2];
---

<header class="sticky top-0 bg-blue-600 text-white shadow-lg z-10">
  <nav class="max-w-6xl mx-auto">
    <div class="flex flex-col sm:flex-row items-center justify-between p-3 sm:p-4">
      <div class="mb-3 sm:mb-0">
        <a
          href="/"
          class="rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70"
        >
          <p
            class="text-xl sm:text-2xl font-extrabold hover:text-blue-100 transition-colors"
          >
            ARGENTISTA
          </p>
        </a>
      </div>
      <div>
        <ul class="flex gap-1 sm:gap-4">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={currentPath === item.href ? "page" : undefined}
                  class={`
                    px-3 sm:px-4 py-1.5 sm:py-2 rounded-lg font-medium text-sm sm:text-base
                    transition-all duration-200
                    hover:bg-blue-500 hover:shadow-md
                    focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/70
                    ${
                      currentPath === item.href
                        ? "bg-blue-700 shadow-sm"
                        : "hover:bg-blue-500"
                    }
                  `}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </nav>
  {
    dollarPrices.length > 0 && (
      <div
        class="ticker relative overflow-hidden text-white h-8 flex items-center border-t border-blue-500/40"
        role="group"
        aria-label="Cotizaciones del dólar"
      >
        <div class="ticker-track">
          {copies.map((copy) => (
            <div
              class="ticker-group"
              aria-hidden={copy === 0 ? undefined : "true"}
            >
              {dollarPrices.map((item) => (
                <span class="inline-flex items-center gap-1.5 sm:gap-2 whitespace-nowrap text-xs sm:text-sm">
                  <strong class="font-semibold">{item.nombre}</strong>
                  <span class="text-blue-100">
                    ${item.compra?.toFixed(2) ?? "N/A"} / $
                    {item.venta?.toFixed(2) ?? "N/A"}
                  </span>
                </span>
              ))}
            </div>
          ))}
        </div>
      </div>
    )
  }
</header>

<style>
  .ticker-track {
    display: flex;
    width: max-content;
    animation: marquee 45s linear infinite;
  }

  .ticker-group {
    display: flex;
    gap: 2rem;
    padding-right: 2rem;
  }

  .ticker:hover .ticker-track,
  .ticker:focus-within .ticker-track {
    animation-play-state: paused;
  }

  @keyframes marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-33.3333%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
      transform: none;
    }
  }
</style>
