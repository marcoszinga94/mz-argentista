---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import Analytics from "@vercel/analytics/astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  url?: string;
  image?: string;
}

const {
  title,
  description = "ARGENTISTA es una aplicación que te permite conocer la economía de Argentina, con datos en tiempo real sobre la inflación y otros indicadores económicos.",
  keywords = "inflación argentina, economía argentina, calculadora de inflación, estadísticas económicas",
  image = "/og_image.jpg",
} = Astro.props;

const site = Astro.site ?? new URL("https://argentista.vercel.app");
const pageTitle =
  title === "ARGENTISTA" ? "ARGENTISTA" : `${title} | ARGENTISTA`;
const canonical = new URL(Astro.url.pathname, site).href;
const socialImage = new URL(image, site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <!-- Icono de la aplicación -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Manifiesto -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#2563eb" />

    <!-- Canonical -->
    <link rel="canonical" href={canonical} />

    <!-- Meta para el SEO -->
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />

    <!-- Meta para redes sociales -->
    <meta property="og:site_name" content="ARGENTISTA" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ARGENTISTA: inflación y dólar en Argentina" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />

    <!-- Meta para Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <!-- Código de GoogleAdSense -->
    <script
      is:inline
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7173856593005932"
      crossorigin="anonymous"></script>

    <!-- Speed Insights -->
    <SpeedInsights />
    <!-- Analytics -->
    <Analytics />
    <!-- Client Router -->
    <ClientRouter />
    <!-- Título de la página -->
    <title>{pageTitle}</title>

    <!-- Datos estructurados -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        name: "ARGENTISTA",
        url: new URL("/", site).href,
        description,
        applicationCategory: "FinanceApplication",
        operatingSystem: "Web",
        inLanguage: "es-AR",
        isAccessibleForFree: true,
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "ARS",
        },
      })}
    />
  </head>
  <body class="bg-gray-100 text-gray-900">
    <div class="flex flex-col min-h-screen">
      <Header transition:persist />
      <main class="flex py-8 flex-1">
        <slot />
      </main>
      <Footer transition:persist />
    </div>
    {
      import.meta.env.PROD && (
        <script is:inline>
          if ("serviceWorker" in navigator) {
            window.addEventListener("load", () => {
              navigator.serviceWorker.register("/sw.js").catch(() => {});
            });
          }
        </script>
      )
    }
  </body>
</html>
