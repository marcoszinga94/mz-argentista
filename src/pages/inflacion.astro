---
import Layout from "../layouts/Layout.astro";
import InflationChart from "../components/InflationChart";
import InflationGraph from "../components/InflationGraph";
import { getInflation } from "../lib/api";

const inflation = await getInflation();

if (inflation.length > 0) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, s-maxage=600, stale-while-revalidate=1800",
  );
}
---

<Layout
  title="Inflación"
  description="Inflación mensual de Argentina: serie histórica por década y año, evolución en el tiempo y promedios para analizar la economía argentina."
>
  <div
    class="flex flex-col md:flex-row justify-center gap-4 sm:gap-6 m-auto max-w-5xl w-full px-3 sm:px-4"
  >
    <h1 class="sr-only">Inflación en Argentina</h1>
    <InflationGraph client:load initialData={inflation} />
    <InflationChart client:load initialData={inflation} />
  </div>
</Layout>
