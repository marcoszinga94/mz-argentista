---
import Layout from "../layouts/Layout.astro";
import InflationCalculator from "../components/InflationCalculator";
import CurrencyConverter from "../components/CurrencyConverter";
import SummaryCards from "../components/SummaryCards.astro";
import { getCountryRisk, getDollarRates, getInflation, getUva } from "../lib/api";

const [inflation, dollarRates, countryRisk, uva] = await Promise.all([
  getInflation(),
  getDollarRates(),
  getCountryRisk(),
  getUva(),
]);

if (inflation.length > 0 && dollarRates.length > 0) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, s-maxage=300, stale-while-revalidate=900",
  );
}
---

<Layout title="ARGENTISTA">
  <section
    class="flex flex-col items-center justify-center gap-4 sm:gap-6 m-auto max-w-5xl w-full px-3 sm:px-4"
  >
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-center text-blue-600 tracking-tight">
      ARGENTISTA
    </h1>

    <p class="text-center text-gray-500 text-sm sm:text-base max-w-2xl px-2">
      Inflación y dólar en Argentina, con datos actualizados.
    </p>

    <SummaryCards
      inflation={inflation}
      rates={dollarRates}
      countryRisk={countryRisk}
      uva={uva}
    />

    <div
      class="flex flex-col items-center justify-center gap-4 w-full"
    >
      <div class="flex flex-col gap-4 w-full md:flex-row h-auto">
        <InflationCalculator client:load initialData={inflation} />
        <CurrencyConverter client:load initialRates={dollarRates} />
      </div>
    </div>

    <p class="text-center text-gray-500 text-xs sm:text-sm px-2">
      Esta aplicación utiliza la API de <a
        class="text-blue-500 underline"
        href="https://argentinadatos.com/"
        target="_blank"
        rel="noopener noreferrer">ArgentinaDatos</a
      > para ofrecer información actualizada y confiable.
    </p>
  </section>
</Layout>
